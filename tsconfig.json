{
  "compilerOptions": {
    "target": "ES2020", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true,
    "baseUrl": ".", "paths": { "api": ["api/index.ts"] },
    "types": ["node", "react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "api/**/*.ts", "types/**/*.d.ts", "tests/**/*.ts"]
}
